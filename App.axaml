<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:ClientAvalonia"
             xmlns:mi="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             x:Class="ClientAvalonia.App"
             RequestedThemeVariant="Light">
  <Application.Resources>
    <!-- Scheme C: cream gray + soft teal-green -->
    <local:Oklch x:Key="CanvasBrush"        L="0.974" C="0.006" H="82" />
    <local:Oklch x:Key="CanvasSoftBrush"    L="0.983" C="0.005" H="82" />
    <local:Oklch x:Key="SurfaceBrush"       L="0.990" C="0.004" H="82" />
    <local:Oklch x:Key="SurfaceRaisedBrush" L="0.996" C="0.003" H="82" />
    <local:Oklch x:Key="SurfaceWarmBrush"   L="0.985" C="0.005" H="82" />
    <local:Oklch x:Key="SurfaceTintBrush"   L="0.956" C="0.020" H="171" />
    <local:Oklch x:Key="MainTabHoverBrush"   L="0.967" C="0.010" H="82" />
    <local:Oklch x:Key="MainTabPressedBrush" L="0.950" C="0.014" H="82" />

    <!-- Soft glass with a restrained green tint -->
    <local:Oklch x:Key="GlassBrush"         L="0.982" C="0.010" H="171" />
    <local:Oklch x:Key="GlassStrongBrush"   L="0.991" C="0.008" H="171" />
    <local:Oklch x:Key="GlassBorderBrush"   L="0.905" C="0.026" H="171" />

    <!-- Neutral warm-gray borders and text -->
    <local:Oklch x:Key="BorderSoftBrush"    L="0.902" C="0.010" H="82" />
    <local:Oklch x:Key="BorderWarmBrush"    L="0.872" C="0.014" H="82" />
    <local:Oklch x:Key="FileRowDividerBrush" L="0.939" C="0.006" H="82" />
    <local:Oklch x:Key="TextStrongBrush"    L="0.300" C="0.018" H="78" />
    <local:Oklch x:Key="TextMutedBrush"     L="0.520" C="0.016" H="78" />

    <!-- Soft teal-green accent -->
    <local:Oklch x:Key="AccentBrush"        L="0.575" C="0.090" H="171" />
    <local:Oklch x:Key="AccentHoverBrush"   L="0.520" C="0.086" H="171" />
    <local:Oklch x:Key="AccentSoftBrush"    L="0.948" C="0.027" H="171" />
    <local:Oklch x:Key="AccentTextBrush"    L="0.455" C="0.072" H="171" />

    <!-- Secondary actions are intentionally neutral instead of amber -->
    <local:Oklch x:Key="SecondaryBrush"      L="0.952" C="0.008" H="82" />
    <local:Oklch x:Key="SecondaryHoverBrush" L="0.925" C="0.012" H="82" />
    <local:Oklch x:Key="SecondaryTextBrush"  L="0.430" C="0.018" H="78" />
    <local:Oklch x:Key="DisabledSurfaceBrush" L="0.940" C="0.004" H="82" />
    <local:Oklch x:Key="DisabledBorderBrush"  L="0.885" C="0.006" H="82" />
    <local:Oklch x:Key="DisabledTextBrush"    L="0.665" C="0.009" H="78" />

    <!-- Status / danger -->
    <local:Oklch x:Key="StatusWarmBrush"    L="0.590" C="0.090" H="171" />
    <local:Oklch x:Key="DangerSoftBrush"    L="0.952" C="0.020" H="22" />
    <local:Oklch x:Key="DangerBrush"        L="0.600" C="0.140" H="22" />
    <local:Oklch x:Key="DangerActionHoverBrush" L="0.920" C="0.038" H="22" />
    <local:Oklch x:Key="DragValidSoftBrush" L="0.944" C="0.026" H="171" />
    <local:Oklch x:Key="CloseHoverBrush"    L="0.555" C="0.210" H="22" />
    <local:Oklch x:Key="ClosePressedBrush"  L="0.455" C="0.200" H="22" />

    <local:Oklch x:Key="ChipActiveHoverBrush"   L="0.912" C="0.036" H="171" />
    <local:Oklch x:Key="ToggleActiveHoverBrush" L="0.908" C="0.038" H="171" />
    <local:Oklch x:Key="SurfaceWarmHoverBrush"   L="0.980" C="0.009" H="82" />
    <local:Oklch x:Key="SurfaceRaisedHoverBrush" L="0.986" C="0.005" H="82" />
    <local:Oklch x:Key="ItemCardHoverBrush"      L="0.950" C="0.014" H="82" />
    <FontFamily x:Key="AppFontFamily">avares://Client.Avalonia/Fonts#HarmonyOS Sans SC</FontFamily>
    <local:TreeIndentToMarginConverter x:Key="TreeIndentToMarginConverter" />
  </Application.Resources>
  <Application.Styles>
    <FluentTheme>
      <FluentTheme.Palettes>
        <ColorPaletteResources x:Key="Light" Accent="#4D9A86" />
      </FluentTheme.Palettes>
    </FluentTheme>
    <mi:MaterialIconStyles />
    <!-- Fix MaterialIcon background artifact -->
    <Style Selector="mi|MaterialIcon">
      <Setter Property="Background" Value="{x:Null}" />
    </Style>
    <Style Selector="ContentPresenter">
      <Setter Property="Transitions">
        <Transitions>
          <BrushTransition Property="Background" Duration="0:0:0.10" />
          <BrushTransition Property="BorderBrush" Duration="0:0:0.10" />
          <BrushTransition Property="Foreground" Duration="0:0:0.10" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Window">
      <Setter Property="Background" Value="{StaticResource CanvasBrush}" />
      <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}" />
    </Style>
    <Style Selector="UserControl">
      <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}" />
    </Style>
    <Style Selector="Border.surface-card">
      <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
      <Setter Property="BorderBrush" Value="{StaticResource BorderSoftBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="14" />
      <Setter Property="BoxShadow" Value="0 10 28 0 #16000000" />
      <Setter Property="Opacity" Value="1" />
      <Setter Property="Transitions">
        <Transitions>
          <BrushTransition Property="Background" Duration="0:0:0.13" />
          <BrushTransition Property="BorderBrush" Duration="0:0:0.13" />
          <DoubleTransition Property="Opacity" Duration="0:0:0.13" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Border.section-card">
      <Setter Property="Background" Value="{StaticResource SurfaceRaisedBrush}" />
      <Setter Property="BorderBrush" Value="{StaticResource BorderSoftBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="12" />
      <Setter Property="BoxShadow" Value="0 3 12 0 #0B000000" />
      <Setter Property="Opacity" Value="1" />
      <Setter Property="Transitions">
        <Transitions>
          <BrushTransition Property="Background" Duration="0:0:0.13" />
          <BrushTransition Property="BorderBrush" Duration="0:0:0.13" />
          <DoubleTransition Property="Opacity" Duration="0:0:0.13" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Border.section-card.hover">
      <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
      <Setter Property="Opacity" Value="0.985" />
    </Style>
    <Style Selector="Border.section-card.drag-valid">
      <Setter Property="Background" Value="{StaticResource DragValidSoftBrush}" />
      <Setter Property="BorderBrush" Value="#2196F3" />
    </Style>
    <Style Selector="Border.section-card.drag-invalid">
      <Setter Property="Background" Value="{StaticResource DangerSoftBrush}" />
      <Setter Property="BorderBrush" Value="#E53935" />
    </Style>
    <Style Selector="Border.models-sidebar-frame">
      <Setter Property="Background" Value="{StaticResource SurfaceRaisedBrush}" />
      <Setter Property="BorderBrush" Value="{StaticResource BorderSoftBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="12" />
      <Setter Property="BoxShadow" Value="0 3 12 0 #08000000" />
      <Setter Property="ClipToBounds" Value="True" />
    </Style>
    <Style Selector="Border.model-sidebar-section">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="{StaticResource FileRowDividerBrush}" />
      <Setter Property="BorderThickness" Value="0,0,0,1" />
      <Setter Property="CornerRadius" Value="0" />
      <Setter Property="BoxShadow" Value="0 0 0 0 #00000000" />
      <Setter Property="Transitions">
        <Transitions>
          <BrushTransition Property="Background" Duration="0:0:0.13" />
          <BrushTransition Property="BorderBrush" Duration="0:0:0.13" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Border.model-sidebar-section.last">
      <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="Grid.slot-drop-placeholder">
      <Setter Property="Opacity" Value="0.9" />
    </Style>
    <Style Selector="Border.slot-drop-surface, Border.voice-model-drop-surface">
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Transitions">
        <Transitions>
          <BrushTransition Property="Background" Duration="0:0:0.16" />
          <BrushTransition Property="BorderBrush" Duration="0:0:0.16" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Border.slot-drop-surface">
      <Setter Property="Background" Value="{StaticResource CanvasSoftBrush}" />
    </Style>
    <Style Selector="Border.voice-model-drop-surface">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="Rectangle.slot-drop-outline">
      <Setter Property="Stroke" Value="{StaticResource BorderWarmBrush}" />
    </Style>
    <Style Selector="Border.model-sidebar-section.drag-valid Border.slot-drop-surface, Border.model-sidebar-section.drag-valid Border.voice-model-drop-surface">
      <Setter Property="Background" Value="{StaticResource DragValidSoftBrush}" />
      <Setter Property="BorderBrush" Value="Transparent" />
    </Style>
    <Style Selector="Border.model-sidebar-section.drag-valid Border.item-card">
      <Setter Property="Background" Value="{StaticResource DragValidSoftBrush}" />
      <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
    </Style>
    <Style Selector="Border.model-sidebar-section.drag-invalid Border.slot-drop-surface, Border.model-sidebar-section.drag-invalid Border.voice-model-drop-surface">
      <Setter Property="Background" Value="{StaticResource DangerSoftBrush}" />
      <Setter Property="BorderBrush" Value="Transparent" />
    </Style>
    <Style Selector="Border.model-sidebar-section.drag-invalid Border.item-card">
      <Setter Property="Background" Value="{StaticResource DangerSoftBrush}" />
      <Setter Property="BorderBrush" Value="{StaticResource DangerBrush}" />
    </Style>
    <Style Selector="Border.voice-model-card.active">
      <Setter Property="Background" Value="{StaticResource AccentSoftBrush}" />
      <Setter Property="BorderBrush" Value="{StaticResource GlassBorderBrush}" />
    </Style>
    <Style Selector="Border.left-accent-bar.active">
      <Setter Property="Background" Value="{StaticResource AccentBrush}" />
    </Style>
    <Style Selector="Border.model-files-panel">
      <Setter Property="BoxShadow" Value="0 3 12 0 #08000000" />
    </Style>
    <!-- Inline drop zone drag feedback (InlinePthDropBorder / InlineIndexDropBorder) -->
    <Style Selector="Border.inline-drop">
      <Setter Property="Transitions">
        <Transitions>
          <BrushTransition Property="Background" Duration="0:0:0.13" />
          <BrushTransition Property="BorderBrush" Duration="0:0:0.13" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Border.inline-drop.drag-valid">
      <Setter Property="BorderBrush" Value="#2196F3" />
    </Style>
    <Style Selector="Border.inline-drop.drag-invalid">
      <Setter Property="BorderBrush" Value="#E53935" />
    </Style>
    <Style Selector="ListBox">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="ListBoxItem">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="Transitions">
        <Transitions>
          <DoubleTransition Property="Opacity" Duration="0:0:0.10" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="ListBoxItem.hover">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="ListBoxItem:selected">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="ListBox.server-files-list ListBoxItem">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="ListBox.server-files-list ListBoxItem:selected">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="ListBox.server-files-list ListBoxItem:pointerover">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="ListBox.server-files-list ListBoxItem:selected:pointerover">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="ListBox.server-files-list ListBoxItem /template/ Rectangle#SelectionIndicator">
      <Setter Property="Fill" Value="Transparent" />
      <Setter Property="Stroke" Value="Transparent" />
    </Style>
    <Style Selector="ListBox.server-files-list ListBoxItem:selected /template/ Rectangle#SelectionIndicator">
      <Setter Property="Fill" Value="Transparent" />
      <Setter Property="Stroke" Value="Transparent" />
    </Style>
    <Style Selector="Border.server-files-frame">
      <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
      <Setter Property="BorderBrush" Value="{StaticResource BorderSoftBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="ClipToBounds" Value="True" />
    </Style>
    <Style Selector="Border.file-table-header">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="{StaticResource FileRowDividerBrush}" />
      <Setter Property="BorderThickness" Value="0,1,0,1" />
    </Style>
    <Style Selector="TextBlock.file-table-header-text">
      <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
      <Setter Property="FontSize" Value="11" />
    </Style>
    <Style Selector="Border.server-file-row">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="{StaticResource FileRowDividerBrush}" />
      <Setter Property="BorderThickness" Value="0,0,0,1" />
      <Setter Property="CornerRadius" Value="0" />
      <Setter Property="Transitions">
        <Transitions>
          <BrushTransition Property="Background" Duration="0:0:0.12" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="ListBox.server-files-list ListBoxItem:pointerover Border.server-file-row">
      <Setter Property="Background" Value="{StaticResource ItemCardHoverBrush}" />
    </Style>
    <Style Selector="ListBox.server-files-list ListBoxItem:selected Border.server-file-row">
      <Setter Property="Background" Value="{StaticResource AccentSoftBrush}" />
    </Style>
    <Style Selector="ListBox.server-files-list ListBoxItem:selected:pointerover Border.server-file-row">
      <Setter Property="Background" Value="{StaticResource AccentSoftBrush}" />
    </Style>
    <Style Selector="ListBox.hub-files-list ListBoxItem">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="ListBox.hub-files-list ListBoxItem:selected">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="ListBox.hub-files-list ListBoxItem:pointerover">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="ListBox.hub-files-list ListBoxItem:selected:pointerover">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="ListBox.hub-files-list ListBoxItem /template/ Rectangle#SelectionIndicator">
      <Setter Property="Fill" Value="Transparent" />
      <Setter Property="Stroke" Value="Transparent" />
    </Style>
    <Style Selector="ListBox.hub-files-list ListBoxItem:selected /template/ Rectangle#SelectionIndicator">
      <Setter Property="Fill" Value="Transparent" />
      <Setter Property="Stroke" Value="Transparent" />
    </Style>
    <Style Selector="Button">
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Transitions">
        <Transitions>
          <BrushTransition Property="Background" Duration="0:0:0.10" />
          <BrushTransition Property="BorderBrush" Duration="0:0:0.10" />
          <BrushTransition Property="Foreground" Duration="0:0:0.10" />
          <DoubleTransition Property="Opacity" Duration="0:0:0.10" />
          <ThicknessTransition Property="BorderThickness" Duration="0:0:0.10" />
          <DoubleTransition Property="FontSize" Duration="0:0:0.10" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Border.selectable-item-card">
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="BoxShadow" Value="0 0 0 0 #00000000" />
      <Setter Property="Transitions">
        <Transitions>
          <BrushTransition Property="Background" Duration="0:0:0.12" />
          <BrushTransition Property="BorderBrush" Duration="0:0:0.12" />
          <DoubleTransition Property="Opacity" Duration="0:0:0.12" />
          <ThicknessTransition Property="BorderThickness" Duration="0:0:0.12" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="ListBoxItem.hover Border.selectable-item-card">
      <Setter Property="BorderBrush" Value="{StaticResource BorderWarmBrush}" />
      <Setter Property="Background" Value="{StaticResource SurfaceRaisedHoverBrush}" />
    </Style>
    <Style Selector="ListBoxItem:selected Border.selectable-item-card">
      <Setter Property="Background" Value="{StaticResource SurfaceRaisedBrush}" />
      <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="BoxShadow" Value="0 0 0 0 #00000000" />
    </Style>
    <Style Selector="ListBoxItem:selected:hover Border.selectable-item-card">
      <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
      <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="BoxShadow" Value="0 0 0 0 #00000000" />
    </Style>
    <Style Selector="Border.status-card">
      <Setter Property="Background" Value="{StaticResource SurfaceRaisedBrush}" />
      <Setter Property="BorderBrush" Value="{StaticResource BorderWarmBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="Transitions">
        <Transitions>
          <BrushTransition Property="Background" Duration="0:0:0.13" />
          <BrushTransition Property="BorderBrush" Duration="0:0:0.13" />
          <DoubleTransition Property="Opacity" Duration="0:0:0.13" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Border.glass-panel">
      <Setter Property="Background" Value="{StaticResource GlassBrush}" />
      <Setter Property="BorderBrush" Value="{StaticResource GlassBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="14" />
      <Setter Property="BoxShadow" Value="0 10 26 0 #12000000" />
      <Setter Property="Transitions">
        <Transitions>
          <BrushTransition Property="Background" Duration="0:0:0.13" />
          <BrushTransition Property="BorderBrush" Duration="0:0:0.13" />
          <DoubleTransition Property="Opacity" Duration="0:0:0.13" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Border.glass-panel.hover">
      <Setter Property="Background" Value="{StaticResource GlassStrongBrush}" />
    </Style>
    <Style Selector="Border.status-pill">
      <Setter Property="Background" Value="{StaticResource AccentSoftBrush}" />
      <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="999" />
      <Setter Property="Padding" Value="12,8" />
      <Setter Property="Transitions">
        <Transitions>
          <BrushTransition Property="Background" Duration="0:0:0.12" />
          <BrushTransition Property="BorderBrush" Duration="0:0:0.12" />
          <DoubleTransition Property="Opacity" Duration="0:0:0.12" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Border.item-card">
      <Setter Property="Background" Value="{StaticResource SurfaceRaisedBrush}" />
      <Setter Property="BorderBrush" Value="{StaticResource BorderSoftBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Opacity" Value="1" />
      <Setter Property="ClipToBounds" Value="True" />
      <Setter Property="Transitions">
        <Transitions>
          <BrushTransition Property="Background" Duration="0:0:0.12" />
          <BrushTransition Property="BorderBrush" Duration="0:0:0.12" />
          <DoubleTransition Property="Opacity" Duration="0:0:0.12" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Border.item-card.hover">
      <Setter Property="Background" Value="{StaticResource CanvasSoftBrush}" />
      <Setter Property="BorderBrush" Value="{StaticResource BorderWarmBrush}" />
      <Setter Property="Opacity" Value="0.985" />
    </Style>
    <Style Selector="Border.left-accent-bar">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Transitions">
        <Transitions>
          <BrushTransition Property="Background" Duration="0:0:0.15" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="ListBoxItem:selected Border.left-accent-bar">
      <Setter Property="Background" Value="{StaticResource AccentBrush}" />
    </Style>
    <Style Selector="ListBoxItem:pointerover Border.item-card">
      <Setter Property="Background" Value="{StaticResource ItemCardHoverBrush}" />
      <Setter Property="BorderBrush" Value="{StaticResource BorderWarmBrush}" />
    </Style>
    <Style Selector="ListBoxItem:selected Border.item-card">
      <Setter Property="Background" Value="{StaticResource AccentSoftBrush}" />
      <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
    </Style>
    <Style Selector="ListBoxItem:selected:pointerover Border.item-card">
      <Setter Property="Background" Value="{StaticResource AccentSoftBrush}" />
      <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
    </Style>
    <Style Selector="Border.server-file-card">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="{StaticResource BorderSoftBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="BoxShadow" Value="0 0 0 0 #00000000" />
      <Setter Property="Transitions">
        <Transitions>
          <BrushTransition Property="Background" Duration="0:0:0.15" />
          <BrushTransition Property="BorderBrush" Duration="0:0:0.15" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="ListBoxItem.hover Border.server-file-card">
      <Setter Property="Background" Value="{StaticResource ItemCardHoverBrush}" />
      <Setter Property="BorderBrush" Value="{StaticResource BorderWarmBrush}" />
    </Style>
    <Style Selector="ListBox.server-files-list ListBoxItem:pointerover Border.server-file-card">
      <Setter Property="Background" Value="{StaticResource ItemCardHoverBrush}" />
      <Setter Property="BorderBrush" Value="{StaticResource BorderWarmBrush}" />
    </Style>
    <Style Selector="ListBoxItem:selected Border.server-file-card">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="BoxShadow" Value="0 0 0 0 #00000000" />
    </Style>
    <Style Selector="ListBoxItem:selected:hover Border.server-file-card">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="BoxShadow" Value="0 0 0 0 #00000000" />
    </Style>
    <Style Selector="ListBox.server-files-list ListBoxItem:selected:pointerover Border.server-file-card">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
      <Setter Property="BoxShadow" Value="0 0 0 0 #00000000" />
    </Style>
    <Style Selector="Border.hub-file-card">
      <Setter Property="Background" Value="{StaticResource SurfaceRaisedBrush}" />
      <Setter Property="BorderBrush" Value="{StaticResource BorderSoftBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="BoxShadow" Value="0 0 0 0 #00000000" />
      <Setter Property="Transitions">
        <Transitions>
          <BrushTransition Property="Background" Duration="0:0:0.15" />
          <BrushTransition Property="BorderBrush" Duration="0:0:0.15" />
          <DoubleTransition Property="Opacity" Duration="0:0:0.15" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Border.hub-file-card:pointerover">
      <Setter Property="Background" Value="{StaticResource ItemCardHoverBrush}" />
