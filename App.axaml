    </Style>
    <Style Selector="StackPanel.animated-panel, Border.animated-panel, Button.animated-panel, Border.inline-error">
      <Setter Property="Opacity" Value="1" />
      <Setter Property="MaxHeight" Value="720" />
      <Setter Property="ClipToBounds" Value="True" />
      <Setter Property="Transitions">
        <Transitions>
          <DoubleTransition Property="Opacity" Duration="0:0:0.12" />
          <DoubleTransition Property="MaxHeight" Duration="0:0:0.14" />
          <ThicknessTransition Property="Margin" Duration="0:0:0.14" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="StackPanel.animated-panel.collapsed, Border.animated-panel.collapsed, Button.animated-panel.collapsed:not(.preserve-layout), Border.inline-error.collapsed">
      <Setter Property="Opacity" Value="0" />
      <Setter Property="MaxHeight" Value="0" />
      <Setter Property="IsHitTestVisible" Value="False" />
    </Style>
    <Style Selector="Border.animated-panel.collapsed">
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="BoxShadow" Value="0 0 0 0 #00000000" />
      <Setter Property="Margin" Value="0" />
    </Style>
    <Style Selector="Button.animated-panel.collapsed:not(.preserve-layout)">
      <Setter Property="Padding" Value="0" />
    </Style>
    <Style Selector="Button.animated-panel.collapsed.preserve-layout">
      <!-- We only override MaxHeight back, or we just let it not match the first selector, 
           and here we explicitly set Opacity to 0 and IsHitTestVisible to False -->
      <Setter Property="Opacity" Value="0" />
      <Setter Property="IsHitTestVisible" Value="False" />
    </Style>
    <Style Selector="Border.inline-error">
      <Setter Property="Background" Value="{StaticResource DangerSoftBrush}" />
      <Setter Property="BorderBrush" Value="{StaticResource DangerBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="12" />
      <Setter Property="Padding" Value="10,8" />
    </Style>
    <Style Selector="Border.inline-error.collapsed">
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="0" />
    </Style>
    <Style Selector="TabControl.main-tabs">
      <Setter Property="Padding" Value="0" />
      <Setter Property="Template">
        <ControlTemplate>
          <Border Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  CornerRadius="{TemplateBinding CornerRadius}">
            <DockPanel>
              <!-- Keep the required items host alive so TabControl can create/select its pages,
                   but collapse its built-in tab headers because navigation is rendered above. -->
              <ItemsPresenter x:Name="PART_ItemsPresenter"
                              DockPanel.Dock="{TemplateBinding TabStripPlacement}"
                              ItemsPanel="{TemplateBinding ItemsPanel}"
                              Height="0"
                              MinHeight="0"
                              MaxHeight="0"
                              Margin="0"
                              Opacity="0"
                              IsHitTestVisible="False" />
              <Panel ClipToBounds="True">
                <ContentPresenter x:Name="PART_SelectedContentHost2"
                                  Margin="{TemplateBinding Padding}"
                                  HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                  VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                                  IsVisible="False" />
                <ContentPresenter x:Name="PART_SelectedContentHost"
                                  Margin="{TemplateBinding Padding}"
                                  HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                  VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
              </Panel>
            </DockPanel>
          </Border>
        </ControlTemplate>
      </Setter>
    </Style>
    <Style Selector="Button.main-tab-header">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Padding" Value="16,7" />
      <Setter Property="Margin" Value="0,0,6,0" />
      <Setter Property="MinHeight" Value="40" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="FontSize" Value="15" />
      <Setter Property="FontWeight" Value="Normal" />
      <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <ControlTemplate>
          <Border Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  CornerRadius="{TemplateBinding CornerRadius}"
                  Padding="{TemplateBinding Padding}">
            <Border.Transitions>
              <Transitions>
                <BrushTransition Property="Background" Duration="0:0:0.14" />
                <BrushTransition Property="BorderBrush" Duration="0:0:0.14" />
              </Transitions>
            </Border.Transitions>
            <ContentPresenter Content="{TemplateBinding Content}"
                              ContentTemplate="{TemplateBinding ContentTemplate}"
                              HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                              Foreground="{TemplateBinding Foreground}"
                              TextBlock.Foreground="{TemplateBinding Foreground}"
                              TextBlock.FontSize="{TemplateBinding FontSize}"
                              TextBlock.FontWeight="{TemplateBinding FontWeight}" />
          </Border>
        </ControlTemplate>
      </Setter>
    </Style>
    <Style Selector="Button.main-tab-header:pointerover">
      <Setter Property="Background" Value="{StaticResource MainTabHoverBrush}" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="Foreground" Value="{StaticResource TextStrongBrush}" />
    </Style>
    <Style Selector="Button.main-tab-header.active">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="Foreground" Value="{StaticResource AccentTextBrush}" />
      <Setter Property="FontWeight" Value="Bold" />
    </Style>
    <Style Selector="Button.main-tab-header.active:pointerover">
      <Setter Property="Background" Value="{StaticResource MainTabHoverBrush}" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="Foreground" Value="{StaticResource AccentTextBrush}" />
    </Style>
    <Style Selector="Button.main-tab-header:pressed">
      <Setter Property="Background" Value="{StaticResource MainTabPressedBrush}" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="Opacity" Value="1" />
    </Style>
    <Style Selector="Button.main-tab-header:focus-visible">
      <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
    </Style>
    <Style Selector="Border.toast-panel">
      <Setter Property="Background" Value="{StaticResource DangerSoftBrush}" />
      <Setter Property="BorderBrush" Value="{StaticResource DangerBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="14" />
      <Setter Property="Padding" Value="18,12" />
      <Setter Property="MinWidth" Value="220" />
      <Setter Property="MaxHeight" Value="60" />
      <Setter Property="Margin" Value="0,0,0,8" />
      <Setter Property="ClipToBounds" Value="True" />
      <Setter Property="Opacity" Value="1" />
      <Setter Property="RenderTransform" Value="translate(0px,0px)" />
      <Setter Property="Transitions">
        <Transitions>
          <DoubleTransition Property="Opacity" Duration="0:0:0.20" />
          <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.20" />
          <DoubleTransition Property="MaxHeight" Duration="0:0:0.20" />
          <ThicknessTransition Property="Margin" Duration="0:0:0.20" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Border.toast-panel.collapsed">
      <Setter Property="MaxHeight" Value="0" />
      <Setter Property="Margin" Value="0" />
      <Setter Property="Opacity" Value="0" />
      <Setter Property="RenderTransform" Value="translate(40px,0px)" />
      <Setter Property="IsHitTestVisible" Value="False" />
    </Style>
    <Style Selector="Border.toast-panel.compacting-up">
      <Setter Property="RenderTransform" Value="translate(0px,14px)" />
    </Style>
    <Style Selector="Border.toast-panel.compacting-bounce">
      <Setter Property="RenderTransform" Value="translate(0px,-2px)" />
    </Style>
    <Style Selector="Button.model-chip">
      <Setter Property="Background" Value="{StaticResource SurfaceRaisedBrush}" />
      <Setter Property="BorderBrush" Value="{StaticResource BorderSoftBrush}" />
      <Setter Property="Foreground" Value="{StaticResource TextStrongBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="12" />
      <Setter Property="Padding" Value="16,8" />
      <Setter Property="MinWidth" Value="96" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <ControlTemplate>
          <Border Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  CornerRadius="{TemplateBinding CornerRadius}"
                  Padding="{TemplateBinding Padding}">
            <Border.Transitions>
              <Transitions>
                <BrushTransition Property="Background" Duration="0:0:0.12" />
                <BrushTransition Property="BorderBrush" Duration="0:0:0.12" />
                <ThicknessTransition Property="BorderThickness" Duration="0:0:0.12" />
              </Transitions>
            </Border.Transitions>
            <ContentPresenter x:Name="PART_ContentPresenter"
                              Background="{x:Null}"
                              Content="{TemplateBinding Content}"
                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                              Foreground="{TemplateBinding Foreground}"
                              TextBlock.Foreground="{TemplateBinding Foreground}" />
          </Border>
        </ControlTemplate>
      </Setter>
    </Style>
    <Style Selector="Button.model-chip:pointerover">
      <Setter Property="Background" Value="{StaticResource AccentSoftBrush}" />
      <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
    </Style>
    <Style Selector="Button.model-chip.active">
      <Setter Property="Background" Value="{StaticResource AccentSoftBrush}" />
      <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
      <Setter Property="BorderThickness" Value="2" />
      <Setter Property="Foreground" Value="{StaticResource AccentTextBrush}" />
    </Style>
    <Style Selector="Button.model-chip.active:pointerover">
      <Setter Property="Background" Value="{StaticResource ChipActiveHoverBrush}" />
      <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
      <Setter Property="BorderThickness" Value="2" />
      <Setter Property="Foreground" Value="{StaticResource AccentTextBrush}" />
    </Style>
    <!-- Prevent FluentTheme from injecting white ContentPresenter background in any pseudostate -->
    <Style Selector="Button.model-chip /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{x:Null}" />
    </Style>
    <Style Selector="Button.model-chip:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{x:Null}" />
    </Style>
    <Style Selector="Button.model-chip:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{x:Null}" />
    </Style>
    <Style Selector="Button.model-chip:focus /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{x:Null}" />
    </Style>
    <Style Selector="Button.model-chip:focus-visible /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{x:Null}" />
    </Style>
    <Style Selector="Button.model-chip:disabled /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{x:Null}" />
    </Style>
    <Style Selector="Button.expander-toggle">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Foreground" Value="{StaticResource TextStrongBrush}" />
      <Setter Property="FontSize" Value="14" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="HorizontalContentAlignment" Value="Left" />
      <Setter Property="Padding" Value="0,6" />
      <Setter Property="Transitions">
        <Transitions>
          <BrushTransition Property="Foreground" Duration="0:0:0.12" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Button.expander-toggle.hover">
      <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
    </Style>
    <Style Selector="Grid.slider-value-row">
      <!-- Reserve the editor's height even while only the value text is shown,
           so toggling edit mode never causes the surrounding layout to reflow. -->
      <Setter Property="MinHeight" Value="20" />
    </Style>
    <Style Selector="TextBlock.slider-value">
      <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Opacity" Value="1" />
      <!-- Keep display text and the inline editor in the same fixed-width slot.
           Let the TextBlock use its natural line height so it shares a baseline
           with the adjacent unit label instead of sitting at the top of a
           forced-height box. -->
      <Setter Property="Width" Value="52" />
      <Setter Property="TextAlignment" Value="Right" />
      <Setter Property="HorizontalAlignment" Value="Right" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Transitions">
        <Transitions>
          <DoubleTransition Property="Opacity" Duration="0:0:0.12" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="TextBox.slider-value-edit">
      <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="HorizontalAlignment" Value="Right" />
      <Setter Property="Width" Value="52" />
      <Setter Property="Height" Value="20" />
      <Setter Property="Opacity" Value="0" />
      <Setter Property="Margin" Value="0,0,-1,0" />
      <Setter Property="Padding" Value="7,0,1,0" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
      <Setter Property="Background" Value="{StaticResource SurfaceRaisedBrush}" />
      <Setter Property="TextAlignment" Value="Right" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="MinHeight" Value="20" />
      <Setter Property="CornerRadius" Value="5" />
      <Setter Property="Transitions">
        <Transitions>
          <BrushTransition Property="Background" Duration="0:0:0.10" />
          <BrushTransition Property="BorderBrush" Duration="0:0:0.10" />
          <DoubleTransition Property="Opacity" Duration="0:0:0.12" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="TextBlock.latency-value">
      <Setter Property="FontSize" Value="18" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{StaticResource AccentTextBrush}" />
    </Style>
    <Style Selector="TextBlock.latency-label">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
    </Style>
    <Style Selector="Border.connection-bar">
      <Setter Property="Background" Value="{StaticResource AccentSoftBrush}" />
      <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="14" />
      <Setter Property="Padding" Value="14,10" />
      <Setter Property="Transitions">
        <Transitions>
          <BrushTransition Property="Background" Duration="0:0:0.12" />
          <BrushTransition Property="BorderBrush" Duration="0:0:0.12" />
          <DoubleTransition Property="Opacity" Duration="0:0:0.12" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Border.connection-bar.hover">
      <Setter Property="Background" Value="{StaticResource AccentSoftBrush}" />
      <Setter Property="Opacity" Value="0.95" />
    </Style>
    <Style Selector="Button.segmented-toggle">
      <Setter Property="Background" Value="{StaticResource CanvasSoftBrush}" />
      <Setter Property="BorderBrush" Value="{StaticResource BorderSoftBrush}" />
      <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="Padding" Value="14,8" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <ControlTemplate>
          <Border Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  CornerRadius="{TemplateBinding CornerRadius}"
                  Padding="{TemplateBinding Padding}">
            <Border.Transitions>
              <Transitions>
                <BrushTransition Property="Background" Duration="0:0:0.12" />
                <BrushTransition Property="BorderBrush" Duration="0:0:0.12" />
                <ThicknessTransition Property="BorderThickness" Duration="0:0:0.12" />
              </Transitions>
            </Border.Transitions>
            <ContentPresenter x:Name="PART_ContentPresenter"
                              Background="{x:Null}"
                              Content="{TemplateBinding Content}"
                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                              Foreground="{TemplateBinding Foreground}"
                              TextBlock.Foreground="{TemplateBinding Foreground}" />
          </Border>
        </ControlTemplate>
      </Setter>
    </Style>
    <Style Selector="Button.segmented-toggle:pointerover">
      <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
    </Style>
    <Style Selector="Button.segmented-toggle.active">
      <Setter Property="Background" Value="{StaticResource AccentSoftBrush}" />
      <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
      <Setter Property="BorderThickness" Value="2" />
      <Setter Property="Foreground" Value="{StaticResource AccentTextBrush}" />
    </Style>
    <Style Selector="Button.segmented-toggle.active:pointerover">
      <Setter Property="Background" Value="{StaticResource ToggleActiveHoverBrush}" />
      <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
      <Setter Property="BorderThickness" Value="2" />
      <Setter Property="Foreground" Value="{StaticResource AccentTextBrush}" />
    </Style>
    <!-- Prevent FluentTheme from injecting white ContentPresenter background in any pseudostate -->
    <Style Selector="Button.segmented-toggle /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{x:Null}" />
    </Style>
    <Style Selector="Button.segmented-toggle:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{x:Null}" />
    </Style>
    <Style Selector="Button.segmented-toggle:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{x:Null}" />
    </Style>
    <Style Selector="Button.segmented-toggle:focus /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{x:Null}" />
    </Style>
    <Style Selector="Button.segmented-toggle:focus-visible /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{x:Null}" />
    </Style>
    <Style Selector="Button.segmented-toggle:disabled /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{x:Null}" />
    </Style>

    <!-- Custom title bar buttons (custom Template for reliable transition) -->
    <Style Selector="Button.titlebar-btn">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{StaticResource TextStrongBrush}" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Width" Value="46" />
      <Setter Property="Height" Value="44" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="CornerRadius" Value="0" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <!-- Single transition layer on the Button property itself; Border uses TemplateBinding only (no own Transitions) -->
      <Setter Property="Transitions">
        <Transitions>
          <BrushTransition Property="Background" Duration="0:0:0.15" />
          <BrushTransition Property="Foreground" Duration="0:0:0.15" />
        </Transitions>
      </Setter>
      <Setter Property="Template">
        <ControlTemplate>
          <Border Background="{TemplateBinding Background}">
            <ContentPresenter x:Name="PART_ContentPresenter"
                              Background="{x:Null}"
                              Content="{TemplateBinding Content}"
                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                              Foreground="{TemplateBinding Foreground}"
                              TextBlock.Foreground="{TemplateBinding Foreground}" />
          </Border>
        </ControlTemplate>
      </Setter>
    </Style>
    <Style Selector="Button.titlebar-btn:pointerover">
      <Setter Property="Background" Value="{StaticResource SurfaceWarmBrush}" />
    </Style>
    <Style Selector="Button.titlebar-btn:pressed">
      <Setter Property="Background" Value="{StaticResource BorderSoftBrush}" />
    </Style>
    <!-- Prevent FluentTheme from injecting white ContentPresenter background in any pseudostate -->
    <Style Selector="Button.titlebar-btn /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{x:Null}" />
    </Style>
    <Style Selector="Button.titlebar-btn:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{x:Null}" />
    </Style>
    <Style Selector="Button.titlebar-btn:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{x:Null}" />
    </Style>
    <Style Selector="Button.titlebar-btn:focus /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{x:Null}" />
    </Style>
    <Style Selector="Button.titlebar-btn:focus-visible /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{x:Null}" />
    </Style>
    <!-- Close button base: transparent (same hue as hover to avoid muddy transition) -->
    <Style Selector="Button.titlebar-close">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="Button.titlebar-close mi|MaterialIcon">
      <Setter Property="Foreground" Value="{StaticResource TextStrongBrush}" />
      <Setter Property="Transitions">
        <Transitions>
          <BrushTransition Property="Foreground" Duration="0:0:0.15" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Button.titlebar-close:pointerover">
      <Setter Property="Background" Value="{StaticResource CloseHoverBrush}" />
      <Setter Property="Foreground" Value="White" />
    </Style>
    <Style Selector="Button.titlebar-close:pointerover mi|MaterialIcon">
      <Setter Property="Foreground" Value="White" />
    </Style>
    <Style Selector="Button.titlebar-close:pressed">
      <Setter Property="Background" Value="{StaticResource ClosePressedBrush}" />
      <Setter Property="Foreground" Value="White" />
    </Style>
    <Style Selector="Button.titlebar-close:pressed mi|MaterialIcon">
      <Setter Property="Foreground" Value="White" />
    </Style>

    <!-- Scheme C layout / hierarchy -->
    <Style Selector="Border.connection-card">
      <Setter Property="Background" Value="{StaticResource SurfaceRaisedBrush}" />
      <Setter Property="BorderBrush" Value="{StaticResource BorderSoftBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="14" />
      <Setter Property="BoxShadow" Value="0 5 18 0 #10000000" />
    </Style>
    <Style Selector="Border.workspace-card">
      <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
      <Setter Property="BorderBrush" Value="{StaticResource BorderSoftBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="14" />
      <Setter Property="BoxShadow" Value="0 8 26 0 #12000000" />
    </Style>
    <Style Selector="Border.workspace-shell">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="BoxShadow" Value="0 0 0 0 #00000000" />
    </Style>
    <Style Selector="Border.right-panel">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="0" />
      <Setter Property="BoxShadow" Value="0 0 0 0 #00000000" />
    </Style>
    <Style Selector="Border.connection-status-card">
      <Setter Property="Background" Value="{StaticResource AccentSoftBrush}" />
      <Setter Property="BorderBrush" Value="{StaticResource GlassBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="Padding" Value="14,11" />
      <Setter Property="MinHeight" Value="64" />
      <Setter Property="Transitions">
        <Transitions>
          <BrushTransition Property="Background" Duration="0:0:0.14" />
          <BrushTransition Property="BorderBrush" Duration="0:0:0.14" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Border.connection-action-group">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="12" />
      <Setter Property="Padding" Value="0" />
    </Style>
    <Style Selector="Border.connection-action-group.model-context">
      <Setter Property="Background" Value="{StaticResource SurfaceRaisedBrush}" />
      <Setter Property="BorderBrush" Value="{StaticResource BorderSoftBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Padding" Value="14" />
      <Setter Property="BoxShadow" Value="0 3 12 0 #08000000" />
    </Style>
    <Style Selector="Border.connection-action-group.model-context Border.connection-status-card">
      <Setter Property="Margin" Value="-14,-14,-14,0" />
      <Setter Property="CornerRadius" Value="12,12,0,0" />
    </Style>
    <Style Selector="Border.connection-action-group.model-context Border.current-voice-summary">
      <Setter Property="Padding" Value="0" />
    </Style>
    <Style Selector="Border.connection-entry">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="Border.current-voice-summary">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="14,0" />
    </Style>
    <Style Selector="Border.right-section-card">
      <Setter Property="Background" Value="{StaticResource SurfaceRaisedBrush}" />
      <Setter Property="BorderBrush" Value="{StaticResource BorderSoftBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="12" />
      <Setter Property="Padding" Value="16" />
      <Setter Property="BoxShadow" Value="0 3 12 0 #0B000000" />
    </Style>
    <Style Selector="Border.audio-device-card">
      <Setter Property="MinHeight" Value="236" />
    </Style>
    <Style Selector="Border.latency-monitor-card">
      <Setter Property="MinHeight" Value="155" />
      <Setter Property="Margin" Value="0,8,0,0" />
    </Style>
    <Style Selector="Border.waveform-monitor-card">
      <Setter Property="MinHeight" Value="229" />
      <Setter Property="Margin" Value="0,8,0,0" />
    </Style>
    <Style Selector="TextBlock.right-section-title">
      <Setter Property="Foreground" Value="{StaticResource TextStrongBrush}" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Border.section-icon">
      <Setter Property="Width" Value="28" />
      <Setter Property="Height" Value="28" />
      <Setter Property="CornerRadius" Value="14" />
      <Setter Property="Background" Value="{StaticResource AccentSoftBrush}" />
    </Style>
    <Style Selector="mi|MaterialIcon.section-icon-glyph">
      <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
      <Setter Property="Width" Value="16" />
      <Setter Property="Height" Value="16" />
      <Setter Property="HorizontalAlignment" Value="Center" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Border.total-latency-card">
      <Setter Property="Background" Value="{StaticResource CanvasSoftBrush}" />
      <Setter Property="BorderBrush" Value="{StaticResource BorderSoftBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="11" />
      <Setter Property="Padding" Value="12,10" />
    </Style>
    <Style Selector="TextBlock.total-latency-value">
      <Setter Property="Foreground" Value="{StaticResource AccentTextBrush}" />
      <Setter Property="FontSize" Value="31" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="HorizontalAlignment" Value="Center" />
    </Style>
    <Style Selector="Border.compact-metric-card">
      <Setter Property="Background" Value="{StaticResource SurfaceWarmBrush}" />
      <Setter Property="BorderBrush" Value="{StaticResource BorderSoftBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="9" />
      <Setter Property="Padding" Value="8,7" />
      <Setter Property="MinHeight" Value="72" />
    </Style>
    <Style Selector="Border.waveform-panel">
      <Setter Property="Background" Value="{StaticResource CanvasSoftBrush}" />
      <Setter Property="BorderBrush" Value="{StaticResource BorderSoftBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="ClipToBounds" Value="True" />
    </Style>
    <Style Selector="Slider">
      <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
      <Setter Property="Background" Value="{StaticResource BorderSoftBrush}" />
      <!-- Each slider declares its own TickFrequency according to parameter
           sensitivity; pointer and keyboard changes snap to those ticks. -->
      <Setter Property="IsSnapToTickEnabled" Value="True" />
    </Style>
    <Style Selector="ToggleSwitch">
      <Setter Property="Foreground" Value="{StaticResource TextStrongBrush}" />
    </Style>
  </Application.Styles>
</Application>
