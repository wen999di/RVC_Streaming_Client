<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mi="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
        x:Class="ClientAvalonia.Dialogs.LocalEnvironmentWindow"
        Width="660"
        SizeToContent="Height"
        CanResize="False"
        CanMaximize="False"
        CanMinimize="False"
        WindowStartupLocation="CenterOwner"
        Title="本地环境设置"
        Background="Transparent"
        WindowDecorations="Full"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaTitleBarHeightHint="44"
        TransparencyLevelHint="Mica"
        KeyDown="Window_OnKeyDown">
  <Window.Styles>
    <Style Selector="WindowDrawnDecorations /template/ Panel#PART_OverlayWrapper">
      <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="WindowDrawnDecorations /template/ Panel#PART_UnderlayWrapper">
      <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="Border.environment-status.success">
      <Setter Property="Background" Value="{StaticResource AccentSoftBrush}" />
      <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
    </Style>
    <Style Selector="Border.environment-status.error">
      <Setter Property="Background" Value="{StaticResource DangerSoftBrush}" />
      <Setter Property="BorderBrush" Value="{StaticResource DangerBrush}" />
    </Style>
    <Style Selector="Border.environment-status.success mi|MaterialIcon">
      <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
    </Style>
    <Style Selector="Border.environment-status.error mi|MaterialIcon">
      <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
    </Style>
  </Window.Styles>

  <Grid>
    <Border Background="{StaticResource CanvasBrush}"
            BorderBrush="{StaticResource BorderSoftBrush}"
            BorderThickness="1"
            CornerRadius="8">
      <Grid RowDefinitions="44,Auto">
        <Grid Grid.Row="0" ZIndex="10">
          <Border Background="Transparent" PointerPressed="TitleBar_PointerPressed" />
          <StackPanel Orientation="Horizontal"
                      Spacing="8"
                      VerticalAlignment="Center"
                      Margin="16,0,52,0"
                      IsHitTestVisible="False">
            <Border Width="26" Height="26" CornerRadius="13" Background="{StaticResource AccentSoftBrush}">
              <mi:MaterialIcon Kind="CogOutline"
                               Width="15" Height="15"
                               Foreground="{StaticResource AccentBrush}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center" />
            </Border>
            <TextBlock Text="本地环境设置"
                       FontSize="13"
                       FontWeight="SemiBold"
                       VerticalAlignment="Center"
                       Foreground="{StaticResource TextStrongBrush}" />
          </StackPanel>
          <Border Height="1" Background="{StaticResource BorderSoftBrush}" VerticalAlignment="Bottom" />
        </Grid>

        <StackPanel Grid.Row="1" Margin="24,22,24,24" Spacing="16">
          <StackPanel Spacing="7">
            <TextBlock Text="Server 路径" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextStrongBrush}" />
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
              <TextBox x:Name="ServerDirectoryTextBox"
                       IsReadOnly="True"
                       Padding="11,8"
                       VerticalContentAlignment="Center" />
              <Button x:Name="BrowseButton"
                      Grid.Column="1"
                      Classes="secondary-action"
                      Width="40"
                      Height="38"
                      Padding="0"
                      Click="Browse_OnClick"
                      ToolTip.Tip="选择 Server 文件夹"
                      Content="{mi:MaterialIconExt Kind=FolderOpenOutline, IconSize=18}" />
            </Grid>
          </StackPanel>

          <Border x:Name="EnvironmentStatusPanel"
                  Classes="environment-status"
                  Background="{StaticResource CanvasSoftBrush}"
                  BorderBrush="{StaticResource BorderSoftBrush}"
                  BorderThickness="1"
                  CornerRadius="8"
                  Padding="12,10">
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
              <mi:MaterialIcon x:Name="EnvironmentStatusIcon"
                               Kind="ClockOutline"
                               Width="18" Height="18"
                               Foreground="{StaticResource TextMutedBrush}"
                               VerticalAlignment="Top" />
              <StackPanel Grid.Column="1" Spacing="4">
                <TextBlock x:Name="EnvironmentStatusTitle"
                           Text="环境尚未检查"
                           FontSize="13"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource TextStrongBrush}" />
                <TextBlock x:Name="EnvironmentStatusDetails"
                           Text=""
                           FontSize="11"
                           TextWrapping="Wrap"
                           Foreground="{StaticResource TextMutedBrush}" />
                <ProgressBar x:Name="EnvironmentCheckProgress"
                             IsIndeterminate="True"
                             IsVisible="False"
                             Height="3"
                             Margin="0,5,0,0" />
              </StackPanel>
            </Grid>
          </Border>

          <TextBox x:Name="DependencyOutputTextBox"
                   IsReadOnly="True"
                   IsVisible="False"
                   AcceptsReturn="True"
                   MinHeight="110"
                   MaxHeight="190"
                   TextWrapping="Wrap"
                   ScrollViewer.VerticalScrollBarVisibility="Auto"
                   FontFamily="Cascadia Code, Consolas, Microsoft YaHei UI"
                   FontSize="10"
                   Padding="10" />

          <Grid ColumnDefinitions="Auto,Auto,Auto,*,Auto,Auto" ColumnSpacing="10">
            <Button x:Name="DownloadServerButton"
                    Classes="secondary-action"
                    Height="38"
                    Click="DownloadServer_OnClick">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <mi:MaterialIcon Kind="Github" Width="16" Height="16" />
                <TextBlock Text="从 GitHub 下载" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
            <Button x:Name="InstallDependenciesButton"
                    Grid.Column="1"
                    Classes="secondary-action"
                    Height="38"
                    IsEnabled="False"
                    Click="InstallDependencies_OnClick">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <mi:MaterialIcon Kind="PackageDown" Width="16" Height="16" />
                <TextBlock Text="下载依赖" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
            <Button x:Name="CheckDependenciesButton"
                    Grid.Column="2"
                    Classes="secondary-action"
                    Height="38"
                    IsEnabled="False"
                    Click="CheckDependencies_OnClick">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <mi:MaterialIcon Kind="CheckDecagramOutline" Width="16" Height="16" />
                <TextBlock Text="检查依赖" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
            <Button Grid.Column="4"
                    Classes="secondary-action"
                    Width="88"
                    Height="38"
                    Content="取消"
                    Click="Cancel_OnClick" />
            <Button x:Name="SaveButton"
                    Grid.Column="5"
                    Classes="primary-action"
                    Width="96"
                    Height="38"
                    IsEnabled="False"
                    Content="保存设置"
                    Click="Save_OnClick" />
          </Grid>
        </StackPanel>
      </Grid>
    </Border>

    <Button Classes="titlebar-btn titlebar-close"
            HorizontalAlignment="Right"
            VerticalAlignment="Top"
            ZIndex="20"
            Click="CloseButton_OnClick"
            Content="{mi:MaterialIconExt Kind=Close, IconSize=20}" />
  </Grid>
</Window>
